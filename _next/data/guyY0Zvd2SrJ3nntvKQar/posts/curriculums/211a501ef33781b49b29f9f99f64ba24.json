"parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"macの場合","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"211a501ef33781d7a0fed9486fbc829f","type":"bookmark","parent":{"type":"bookmark","bookmark":{"parent":[],"url":"https://matsuand.github.io/docs.docker.jp.onthefly/desktop/mac/install/","ogp":{"title":"Docker Desktop の Mac へのインストール | Docker ドキュメント","description":"Docker Desktop の Mac へのインストール方法を説明します。","image":"https://matsuand.github.io/docs.docker.jp.onthefly/favicons/docs@2x.ico","icon":"https://matsuand.github.io/docs.docker.jp.onthefly/favicons/docs@2x.ico"}}},"children":[]},{"blockId":"211a501ef33781b0a839d3728e439d02","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[]},{"blockId":"211a501ef337812a92b9f47081f7c205","type":"toggle","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Linux（Ubuntu）の場合はDocker Engine（cli）をインストールします","href":null,"is_same_bp":false}]}},"children":[{"blockId":"211a501ef33781cf90aee93a7b98133f","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"一つずつ実行してください","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"211a501ef33781acbd8ed696f48cd810","type":"code","parent":{"type":"code","code":{"language":"shell","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"# 1. 既存のDockerがあれば削除\nsudo apt remove docker docker-engine docker.io containerd runc\n\n# 2. 必要なパッケージをインストール\nsudo apt update\nsudo apt install -y ca-certificates curl gnupg\n\n# 3. Dockerの公式GPGキー追加\nsudo install -m 0755 -d /etc/apt/keyrings\ncurl -fsSL https://download.docker.com/linux/ubuntu/gpg | \\\n  sudo gpg --dearmor -o /etc/apt/keyrings/docker.gpg\n\n# 4. リポジトリ追加\necho \\\n  \"deb [arch=$(dpkg --print-architecture) \\\n  signed-by=/etc/apt/keyrings/docker.gpg] \\\n  https://download.docker.com/linux/ubuntu \\\n  $(lsb_release -cs) stable\" | \\\n  sudo tee /etc/apt/sources.list.d/docker.list > /dev/null\n\n# 5. Docker本体のインストール\nsudo apt update\nsudo apt install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin\n\n# 6. dockerコマンドが動くか確認\nsudo docker run hello-world\n","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"211a501ef33781c7aa6ed0ea7337cfff","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"sudoなしで使いたい場合：","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"211a501ef33781b295a4cb987a25b8cb","type":"code","parent":{"type":"code","code":{"language":"shell","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"sudo usermod -aG docker $USER\nnewgrp docker","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"211a501ef33781e88bb7d22baea2b7e2","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"インストールが完了したら","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"211a501ef33781118cb9e26e58e0394e","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"211a501ef33781069819e7b1f0366424","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"インストールが完了したら以下のコマンドを実行できるか確認してください","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"211a501ef33781c7b0f7e4a9f701b9cb","type":"code","parent":{"type":"code","code":{"language":"shell","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"docker --version\ndocker run hello-world","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"211a501ef3378153ad95c7340aa5f1d8","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次→","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Dockerとは？","href":"/posts/curriculums/211a501ef337819581b6ebbc6999f155","is_same_bp":false}]}},"children":[]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"技術ガイド","link":"/posts/course/1e0a501ef3378063b111dff8a4ce1c9b"},{"title":"Dockerガイド","link":"/posts/curriculums/211a501ef3378033aba3e2b9e036eacf"},{"link":"/posts/curriculums/211a501ef33781b49b29f9f99f64ba24","title":"Dockerのインストール"}],"pageId":"211a501ef33781b49b29f9f99f64ba24","iconUrl":"https://www.notion.so/icons/arrow-down-line_blue.svg","iconType":"external","coverUrl":"","firstText":"インストール方法","ogpImagePath":"https://raw.githubusercontent.com/Ryukoku-Horizon/atlas-storage/main/notion_data/ogp/211a501ef33781b49b29f9f99f64ba24.png","resourceType":"curriculum","v":"1.2.10"},"__N_SSG":true}