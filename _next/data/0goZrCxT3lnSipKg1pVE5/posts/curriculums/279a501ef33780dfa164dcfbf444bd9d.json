ine":false},"plain_text":"誰も借りていなかったら戻って再度借りるの二度手間だから守衛さんに鍵が借りてあるか確認しよう。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"279a501ef337803594b0d4f47761ef46","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"確認&借りる手順","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"279a501ef33780aa863ec83f4dfd8cb6","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"1.守衛さんに「プログラミング部です。鍵を借りたいです」と伝える\nすでに誰かが借りている場合はこの時点で「出てます」って言われるので部室までGO","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"279a501ef33780e5bbc5cdd171da081f","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"2.学生証をみせ、紙に以下の内容を記述する。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"279a501ef33780349f12e23c414864cf","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"3.学籍番号、氏名、所属サークル：Horizon、部屋番号：102、鍵の番号：2、鍵の本数：２本","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"279a501ef3378096a496f33c3c083c52","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"4.記述したら鍵を渡してもらえるから持っていこう","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"279a501ef337809d8e91c0cbdff61027","type":"image","parent":{"type":"image","image":{"parent":[],"url":"ht