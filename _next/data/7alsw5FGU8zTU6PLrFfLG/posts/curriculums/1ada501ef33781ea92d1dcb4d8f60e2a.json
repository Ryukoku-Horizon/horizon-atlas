tations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"目次","href":null,"is_same_bp":false}]}},"children":[{"blockId":"414a501ef33780ae887ff46fbb96f76d","type":"table_of_contents","parent":{"type":"table_of_contents","table_of_contents":[{"header_type":2,"block_id":"1ada501ef337815e9769eb5e61635c59","text":"使用するライブラリ"},{"header_type":2,"block_id":"1ada501ef33781e88515c29b6cd990d4","text":"VSCodeで拡張機能をインストールする"},{"header_type":2,"block_id":"1ada501ef337813f8ffcf03cab7ce301","text":"データベースファイル作成"}]},"children":[]}]},{"blockId":"414a501ef33780e1b891d274e92f224d","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1ada501ef337815e9769eb5e61635c59","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"使用するライブラリ","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"1ada501ef33781d69dc6de285923f04e","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1ada501ef3378149aa5dc2d111c15daf","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Pythonでデータベースを扱うライブラリはいくつかありますが、ここでは「","href":null,"is_same_bp":false},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"sqlite3","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"」というライブラリを使用します。sqlite3は、pythonの標準ライブラリであるため、ライブラリをインストールする必要はありません。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef33781d595bdeed64cf6574a","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"sqlite3は、SQLiteという、軽量のDBMS（データベース管理システム）を扱えるライブラリです。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef3378125a392f8e00b6ab121","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"SQLiteは名前のとおり、簡易的な（ライトな）データベースです。データベースは大掛かりなシステムで利用される、という印象が強いものですが、SQLiteは簡易的に利用することが可能です。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef33781b09eb2e828b8d82132","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"SQLiteが他のDBMS（データベース管理システム）よりも簡単にデータベースを扱える理由は、他の多くのDBMSがデータベースをサーバーとして扱うのに対して、SQLiteがデータベースをファイルで扱うからです。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef33781e88515c29b6cd990d4","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"VSCodeで拡張機能をインストールする","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"1ada501ef3378123b487e1dc5e249f46","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1ada501ef33781e0a5e5de103b155207","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"sqlite3を使う前に、sqlite3を使う上で便利なVSCodeの拡張機能をインストールしましょう。「SQLite3 Editor」という拡張機能をインストールします。この拡張機能を入れることによって、sqlite3で扱うデータベースファイルの中身を見たり編集したりすることができるようになります。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef337816595a0fc35be82cfaf","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"VSCodeの画面左の拡張機能で「sqlite3」と検索してください。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef33781158f38f0a3c7c63d1d","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"「SQLite3 Editor」を選択して、インストールしてください。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef337813f8ffcf03cab7ce301","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"データベースファイル作成","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"1ada501ef337811c9595f7a29c878502","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1ada501ef337810dad75e0b117cd8a36","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"SQLiteで扱うデータベースファイルは、ファイルの拡張子が「.db」です。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef33781428374fbe5496fb1ee","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"試しに、VSCode上で、「TEST.db」というファイルを作成してください。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef33781f69c32e062aa5af97a","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"TEST.dbを開いてください。上述した拡張機能をインストールしていれば、以下のように表示されます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1ada501ef337811b96aaf429c95174a1","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[{"blockId":"414a501ef3378077b86bd604518c3f45","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"S1：","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"前回(データベースとは)","href":"/posts/curriculums/p/1ada501ef33781ce889fd99449a4ba30","is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"　｜　","href":null,"is_same_bp":false},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"S2：","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次回(データベースとの接続とテーブルの作成)","href":"/posts/curriculums/p/1ada501ef3378160b03ef28f8a18fa43","is_same_bp":false}]}},"children":[]}]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"技術ガイド","link":"/posts/course/1e0a501ef3378063b111dff8a4ce1c9b"},{"title":"基礎班カリキュラム","link":"/posts/course/basic"},{"title":"後期","link":"/posts/course/1aea501ef3378132bd43e21de0be4f7b?is_basic=true"},{"title":"データベース基礎","link":"/posts/curriculums/1ada501ef33781e8b251df0f38a0cb23"},{"link":"/posts/curriculums/1ada501ef33781ea92d1dcb4d8f60e2a","title":"Pythonでデータベースを扱うためのライブラリ"}],"pageId":"1ada501ef33781ea92d1dcb4d8f60e2a","ic