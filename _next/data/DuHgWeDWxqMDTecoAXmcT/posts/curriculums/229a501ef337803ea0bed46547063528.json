e,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    def clicked(e):\n        txtfld.value = e.control.text\n        txtfld.update\n    \n    button_a = ft.ElevatedButton(text=\"A!\", on_click=clicked)\n    button_b = ft.ElevatedButton(text=\"B!\", on_click=clicked)\n    button_c = ft.ElevatedButton(text=\"C!\", on_click=clicked)\n    txtfld = ft.TextField(value=\"\")\n\n    page.add(\n        ft.Row(\n            controls=[button_a, button_b, button_c]\n        ),\n        txtfld\n    )\n\nft.app(target=main)","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"34aa501ef337806aadd1f12241a65f7a","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[]},{"blockId":"229a501ef337815c86d8ccbdf6880c6b","type":"heading_1","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"問題４","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"229a501ef33781de9d4eced1876e3d81","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"229a501ef33781d5ac18d61e8bddfc90","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"プラスボタンを押すと数字が１ずつ増え、マイナスボタンを押すと数字が１ずつ減るアプリを作ってみました。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"229a501ef337819baaccfc019a3ce2e4","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"でも、ボタンを押しても数字は変わらず、エラーが出てしまいます。このエラーを解決し、数字が変わるようにするには…？","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"229a501ef33781ca8630dff7aede9f64"