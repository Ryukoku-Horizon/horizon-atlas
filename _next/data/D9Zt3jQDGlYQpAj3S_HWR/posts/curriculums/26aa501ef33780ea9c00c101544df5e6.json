olor":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":": 「ブランチ」を作って新機能の開発やバグ修正を並行して進め、後で統合（マージ）できます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"26aa501ef33781479be5eadda8ef92a7","type":"bulleted_list_item","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"差分管理","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":": 各変更の内容を記録し、複数人で同時に作業してもその差分を管理できます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"26aa501ef33781bfb3bce442c7add217","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Gitはあくまでローカルで動作するもので、開発者が自分のパソコンでコードを管理するために使われます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"3e6a501ef3378079ba55f0f9ae4335bc","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[]},{"blockId":"26aa501ef3378173898af6f6e7f35f79","type":"heading_1","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Githubとは","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"26aa501ef3378124bcb6ea4a0ca1d389","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"GitHub","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plai