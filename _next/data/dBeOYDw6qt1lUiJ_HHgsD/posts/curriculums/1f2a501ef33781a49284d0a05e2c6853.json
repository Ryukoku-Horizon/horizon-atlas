aragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"まずは、好きな場所に「","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"blue","italic":false,"strikethrough":false,"underline":false},"plain_text":"counter.py","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"」という名前でファイルを作成しましょう。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"344a501ef3378049b845fb46fd89d2ba","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次に、","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"blue","italic":false,"strikethrough":false,"underline":false},"plain_text":"counter.py","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" に以下のプログラムを貼り付けてください。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"344a501ef33780d9ac91cd1110339d59","type":"callout","parent":{"type":"callout","callout":{"color":"green_background","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"今はコードは理解できなくても大丈夫です!","href":null,"is_same_bp":false}],"icon":{"type":"emoji","emoji":"👌"}}},"children":[]},{"blockId":"344a501ef3378033bdb2e71a48d2b68e","type":"callout","parent":{"type":"callout","callout":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"貼り付けてもらうコード","href":null,"is_same_bp":false}],"icon":{"type":"icon","icon":{"color":"gray","name":"code"}}}},"children":[{"blockId":"344a501ef337802db81fd537ceed4ba9","type":"code","parent":{"type":"code","code":{"language":"python","caption":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"from : ","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"https://flet.dev/docs/","href":"https://flet.dev/docs/","is_same_bp":false}],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    page.title = \"Flet counter example\"\n    page.vertical_alignment = ft.MainAxisAlignment.CENTER\n\n    txt_number = ft.TextField(value=\"0\", text_align=ft.TextAlign.RIGHT, width=100)\n\n    def minus_click(e):\n        txt_number.value = str(int(txt_number.value) - 1)\n        page.update()\n\n    def plus_click(e):\n        txt_number.value = str(int(txt_number.value) + 1)\n        page.update()\n\n    page.add(\n        ft.Row(\n            [\n                ft.IconButton(ft.Icons.REMOVE, on_click=minus_click),\n                txt_number,\n                ft.IconButton(ft.Icons.ADD, on_click=plus_click),\n            ],\n            alignment=ft.MainAxisAlignment.CENTER,\n        )\n    )\n\nft.run(main)","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"367a501ef33780989f66f67ff7d49445","type":"callout","parent":{"type":"callout","callout":{"color":"yellow_background","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"アップデートにより、アイコンの書き方が ft.icons（小文字）から ft.Icons（大文字）に変更されました。 ネット上の古い記事やAIの回答をそのままコピーすると、小文字になっていてエラーが出ることがあります。色を指定する ft.colors なども ft.Colors（大文字）に変わっているため、エラーが出た際は「大文字・小文字」の指定が間違っていないか疑ってみましょう。","href":null,"is_same_bp":false}],"icon":{"type":"emoji","emoji":"⚠️"}}},"children":[]},{"blockId":"344a501ef337806aa751ef1450f58806","type":"heading_1","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Fletアプリの実行方法","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"344a501ef33780119696e27078eb9e27","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"344a501ef3378094b98ce53d03d5274a","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Fletで作成したアプリ・プログラムは ","href":null,"is_same_bp":false},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"CLIコマンド","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" で実行します。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"344a501ef337808c8659e4d970919d1d","type":"image","parent":{"type":"image","image":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/atlas-storage/main/notion_data/assets/1f2a501ef33781a49284d0a05e2c6853/344a501ef337808c8659e4d970919d1d.png","width":1600,"height":449}},"children":[]},{"blockId":"344a501ef33780fe8d49fee08f0ecebb","type":"callout","parent":{"type":"callout","callout":{"color":"blue_background","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これまで同様、実行ボタンでも動かせますが、コマンドで実行したほうが動作が安定するほか、様々なメリットがあります。（様々なFlet独自の機能が使用できます！）","href":null,"is_same_bp":false}],"icon":{"type":"emoji","emoji":"☝"}}},"children":[{"blockId":"344a501ef3378051b8c8d967f33e8772","type":"paragraph","parent":{"type":"