"   size=50  color=ft.colors.PINK',\n                color=ft.colors.BLACK54,\n            )\n        ]\n    )\n\n    t3 = ft.Column(\n        controls=[\n            ft.Text(\n                value=\"背景色も変えられます\",\n                size=30,\n                color=ft.colors.WHITE,\n                bgcolor=ft.colors.GREEN\n            ),\n            ft.Text(\n                value='value=\"背景色も変えられます\"  size=30  color=ft.colors.WHITE  bgcolor=ft.colors.GREEN',\n                color=ft.colors.BLACK54,\n            )\n        ]\n    )\n\n    t4 = ft.Column(\n        controls=[\n            ft.Text(\n                spans=[\n                    ft.TextSpan(\n                        text=\"styleやspansを設定すると\"\n                    ),\n                    ft.TextSpan(\n                        text=\"斜体にしたり、\",\n                        style=ft.TextStyle(\n                            color=ft.colors.PURPLE,\n                            italic=True,\n                        )\n                    ),\n                    ft.TextSpan(\n                        text=\"取り消し線を引いたり、\",\n                        style=ft.TextStyle(\n                            color=ft.colors.RED,\n                            decoration=ft.TextDecoration.LINE_THROUGH,\n                            decoration_thickness=3,\n                        )\n                    ),\n                    ft.TextSpan(\n                        text=\"影をつけたり、\",\n                        style=ft.TextStyle(\n                            color=ft.colors.ORANGE,\n                            shadow=ft.BoxShadow(\n                                spread_radius=10,\n                                blur_radius=3,\n                                color=ft.colors.BLACK26,\n                            )\n                        )\n                    ),\n                    ft.TextSpan(\n                        text=\"リンクを設定したり\",\n                        style=ft.TextStyle(\n                            color=ft.colors.BLUE_500,\n                            decoration=ft.TextDecoration.UNDERLINE,\n                            decoration_color=ft.colors.BLUE_500,\n                        ),\n                        url=\"https://flet.dev/\"\n                    ),\n                    ft.TextSpan(\n                        text=\"できます。\"\n                    )\n                ],\n            ),\n            ft.Text(\n                value=\"spans=[中略・下記コードを参照]\",\n                color=ft.colors.BLACK54,\n            )\n        ]\n    )\n\n    clm = ft.Column(\n        controls=[\n            t1, t2, t3, t4,\n        ]\n    )\n\n    page.add(clm)\n\nft.app(target=main)\n","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"1f2a501ef337817f9394cde92a041b9b","type":"heading_1","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"主なプロパティ","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"1f2a501ef33781eeb09dc180454fcfee","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1f2a501ef3378187af66ec99697a798b","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"value","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"1f2a501ef337815eba1de03d0c4d64a7","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1f2a501ef33781d88879dc4e7baaa0fa","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"表示するテキストを設定します。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"1f2a501ef33781368cb5f374827b2809","type":"heading_2","parent":{"t