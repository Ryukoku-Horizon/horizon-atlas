n    page.on_view_pop = view_pop\n\n    route_change()\n\n\nft.run(main)","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"30ea501ef3378364a252812986ea446c","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"先ほどのコードでは","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"View","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"を一つしか設置していなかったのに、こちらでは問答無用で「","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"/","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"」ページが設置された後に指定されたルートが「","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"/info","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"」の場合にその上に表示するようになっています。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"094a501ef33782289f1101b5383864d1","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"さらに、","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"appbar","href":null,"is_same_bp":false},{"annotation