        page.views.append(info_view)\n        else:\n            page.views.append(counter_view)\n\n    page.on_route_change = route_change\n    route_change()\n\nft.run(main)","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"bc2a501ef33783818b3401328da54556","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"この書き方であれば静的ルーティングを直感的に実装できます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"d85a501ef337826f92dc012bb0e5c214","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"変更点の説明ですが、新しく出てきたものを中心に説明していきます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"6a6a501ef33783d3be36011ab5e61499","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"1. ","href":null,"is_same_bp":false},{"annotations":{"bold":true,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"page.route","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"142a501ef3378267bdc30186ed1d7fa2","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"今どのページにいるかを表す文字列です。","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"/","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"under