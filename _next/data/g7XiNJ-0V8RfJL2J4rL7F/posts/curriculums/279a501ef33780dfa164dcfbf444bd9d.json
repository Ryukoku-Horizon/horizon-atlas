,"type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef3378064b437d1e15e9ac198.jpg","height":370,"width":550,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780b4bdabcbc9345361ca","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"さて、紫光館についたね。\n紫光館から部室までの道のりを今から書いていくね","href":null}]},"children":[]},{"blockId":"279a501ef33780c19874e5c061685024","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"1.正面入り口を左に曲がる","href":null}]},"children":[]},{"blockId":"279a501ef337800b9a9dcd9fcc10b8bb","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef337800b9a9dcd9fcc10b8bb.jpg","height":1575,"width":2100,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780979d5cc23d3c37eb88","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"2.左に曲がったらすぐ右へ曲がる","href":null}]},"children":[]},{"blockId":"279a501ef33780a3bdacfd34c3fb1dfe","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef33780a3bdacfd34c3fb1dfe.jpg","height":1575,"width":2100,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780019da1e744502c00d7","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"3.守衛室に行くために、自販機の横を右に曲がる","href":null}]},"children":[]},{"blockId":"279a501ef33780d4ac8fd10483cd1a01","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef33780d4ac8fd10483cd1a01.jpg","height":1575,"width":2100,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780ca8457ea72461806ed","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"4.鍵を借りる","href":null}]},"children":[]},{"blockId":"279a501ef337800ca290ddbb818179f8","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"誰も借りていなかったら戻って再度借りるの二度手間だから守衛さんに鍵が借りてあるか確認しよう。","href":null}]},"children":[]},{"blockId":"279a501ef337803594b0d4f47761ef46","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"確認&借りる手順","href":null}]},"children":[]},{"blockId":"279a501ef33780aa863ec83f4dfd8cb6","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"1.守衛さんに「プログラミング部です。鍵を借りたいです」と伝える\nすでに誰かが借りている場合はこの時点で「出てます」って言われるので部室までGO","href":null}]},"children":[]},{"blockId":"279a501ef33780e5bbc5cdd171da081f","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"2.学生証をみせ、紙に以下の内容を記述する。","href":null}]},"children":[]},{"blockId":"279a501ef33780349f12e23c414864cf","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"p