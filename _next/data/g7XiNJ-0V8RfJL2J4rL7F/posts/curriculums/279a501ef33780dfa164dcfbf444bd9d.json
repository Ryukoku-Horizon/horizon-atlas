n2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef3378036a848e0a14e1f3660.jpg","height":1575,"width":2100,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780a69fcaeeaf243e8650","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"7.右折し、将棋サークル（愛棋会）に前を通り過ぎたら….","href":null}]},"children":[]},{"blockId":"279a501ef3378032afcfdd60977cc75a","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef3378032afcfdd60977cc75a.jpg","height":1575,"width":2100,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780b8995cc9436d6e07c0","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"GOAL！！！！","href":null}]},"children":[]},{"blockId":"279a501ef33780ca9c5ce3e6a4429735","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef33780ca9c5ce3e6a4429735.jpg","height":1575,"width":2100,"type":"jpg"},"children":[]},{"blockId":"279a501ef33780c1948ffe8d2669d9d0","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"フロアマップだよ。迷ったら参考にしてね。","href":null}]},"children":[]},{"blockId":"279a501ef3378011a312e234b2d3f386","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/279a501ef3378011a312e234b2d3f386.jpg","height":960,"orientation":1,"width":1706,"type":"jpg"},"children":[]},{"blockId":"279a501ef3378032919de631e22dfff9","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"当部の部室の窓などはドイツの技術が使われている？？らしくもう壊れてしまったら直せないみたいだ！暴れたりして壊さないように。","href":null}]},"children":[]},{"blockId":"279a501ef33780c2a6fcc175b9689be0","type":"heading_2","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"部室の使用に関して","href":null}]},"children":[]},{"blockId":"279a501ef337804782b4fd252a082ab1","type":"heading_3","parent":{"color":"default","is_toggleable":true,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"利用可能時間","href":null}]},"children":[{"blockId":"279a501ef33780d3bb10f85c8c54fb7a","type":"heading_3","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"授業がある期間","href":null}]},"children":[]},{"blockId":"279a501ef3378062bc82f456131301b1","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"平日・土曜日：9時〜21時","href":null}]},"children":[]},{"blockId":"279a501ef3378023aeffd563032fecb3","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"日曜日・祝日：9時〜19時","href":null}]},"children":[]},{"blockId":"279a501ef337806ab6d1f168f9d95cfc","type":"paragraph","parent":{"color":"default","parent":[]},"children":[]},{"blockId":"279a501ef33780daa935f58481f833f9","type":"heading_3","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"長期休暇中","href":null}]},"children":[]},{"blockId":"279a501ef3378057b729c85f43a003fe","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"平日・土日祝：9時〜19時","href":null}]},"children":[]},{"blockId":"279a501ef33780c4899ff04ec5011664","type":"paragraph","parent":{"color":"default","parent":[]},"children":[]}]},{"blockId":"279a501ef3378088a604e134da2842db","type":"heading_3","parent":{"color":"default","is_toggleable":true,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"使用ルール","href":null}]},"children":[{"blockId":"279a501ef33780e7a7e8e2669da1d307","type":"bulleted_list_item","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"部室の使用に関して次に掲げる事項を責任をもって遵守しなければならない。\n(1)  指定の場所以外での喫煙、その他火器の使用を禁止する\n(2) 部室内は各部において清掃し、備品･用具等は常に整頓しておくこと\n(3)部室内の設備･備品を部室外に持ち出すことはできない。ただし、必要な場合は持ち出す旨を伝え許可の上持ち出すこと\n(4) シャワー室・便所等の共同の器具は大切に取扱い、他に迷惑をかけないよう注意すること(5)部室を使用できる部室の鍵は各部責任者（貸与者）に貸与し、責任者は部室の盗難予防、防災に留意、施錠等の責任を負うものとする","href":null}]},"children":[]},{"blockId":"279a501ef33780e0a800fdbcc430de26","type":"bulleted_list_item","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"部室の入室および利用の資格を次の通り定める","href":null}]},"children":[{"blockId":"279a501ef337801fab71e583e1274bf0","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"(1) 部室を使用できる部は、プログラミング部Horizonに属しているものに限る。\n(2) 学内団体に属さないもの(Horizonに属さないもの)が個人または有志で利用する場合は、幹事長または各支部代表者を経由して許可を得なければならない。\n(3) 本学学生以外の者の入室は禁ずる。ただし、本学教職員および学生部の許可を得た者は、この限りではない。","href":null}]},"children":[]}]}]},{"blockId":"279a501ef3378035bd82ed75113b57a6","type":"paragraph","parent":{"color":"default","parent":[]},"children":[]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"部活情報","link":"/posts/infos"},{"title":"部室の場所とルール","link":"/posts/curriculums/279a501ef33780dfa164dcfbf444bd9d"}],"pageId":"279a501ef33780dfa164dcfbf444bd9d","iconUrl":"https://www.notion.so/icons/couch_green.svg","iconType":"external","coverUrl":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/279a501ef33780dfa164dcfbf444bd9d/cover.jpeg?X-Amz-Algorithm=AWS4-HMAC-SHA256&X-Amz-Content-Sha256=UNSIGNED-PAYLOAD&X-Amz-Credential=ASIAZI2LB466YXCJU3MF%2F20251204%2Fus-west-2%2Fs3%2Faws4_request&X-Amz-Date=20251204T031329Z&X-Amz-Expires=3600&X-Amz-Security-Token=IQoJb3JpZ2luX2VjEHMaCXVzLXdlc3QtMiJHMEUCIQC2e9uSisckCn0lCfqWmiyTjjzh00ECxd160NyhRIXiwgIgeHft4NeVan5WARxhzDPw%2BPG5qGL6uHq6tKa6CGVCzX0q%2FwMIOxAAGgw2Mzc0MjMxODM4MDUiDNoopHtxHTHuppJEfyrcAwGLLHdgwkCeVEMZuQhppH5aLSVf5ScxIsfWZanQCQ5AmAOI5oWUeVbqkxQGvS%2BZ%2F8jdJ%2Bxe0riobXMDFJKw1oADXcDYswgxMqOVPWoGNbVpRue%2BLJB4jMBnCWHotMbo%2Fxwwx4ltnRfRTa0OdU5%2BNGT3l7XVpK67ZD77yRXQElugmoP3aB1gRabgfmK6pgiPEu0BSWG19rs%2Bz3hJg5csAPiQG03v%2FOe6nbUyj5HBqHFs502sjqUSacdcxq9Lnq7xicBgnNxJbAiQ0AbyLCeJGAFhEtjxACnzIYXfFUqqJKQUYnpF2NO27PklqifiTQb3GgeeyYHMG1VhLcO1NMLLx2YEFSePliJV1uB008OGJ69q4%2FF6XIXNxi%2FWT3F5BurBc4MFbtqDJ70ziVTXhrSLdwVO6nXTBYzTOOWEk2%2BSTLq60gBr8AXciJdIf04U%2FUK%2F8iv26%2Fq%2B%2BgwKL6Ewtj22DbeVh%2BPvf2X1n2UUzo52oUE0cp7xoV3p%2BdL%2B3PPlUB0%2BsxkFHx8lii5TC3mCSd0K%2BMq7ewv4uyosSeW8u%2FpR%2F%2F28mn80ZIzrh%2B%2FO05tYyl6EHIkGalBWVoSLb1ZEv3G8xaoAwFLb9MLdPwZsE%2Fc8D51kE6CFlbD2ORy6PbzIMJ7gw8kGOqUBA1hgFsYteOEuccG2KbhTxpFHFlEfL4C7C2yce06cvdnXVkiaNOaeFLDx5D%2BHwP2g0WtRR0MsR%2FhpqlT%2FAfUN0zNim3my50l9Eu2rpoVWHsuXvIIa1i8PEROvKg7sdpELoRCCOPH7vH0AmHGc2bb8X3gEDrW6C%2FkBSBumEx7OFLdZJlDodzxj8VP1ATRTGrWEQCgRJ%2FrovPmuM3HNNP1Et%2FmUG%2Fgs&X-Amz-Signature=fdbd2e22496a0509333a4e1f0a13f