tent.com/Ryukoku-Horizon/atlas-storage/main/notion_data/assets/1f2a501ef33781c09affe4634d3f7993/344a501ef337809599bdeb99dc4b1c38.png","width":652,"height":371}},"children":[]},{"blockId":"344a501ef33780e0b20bf8e04361cc3a","type":"callout","parent":{"type":"callout","callout":{"color":"default_background","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ft.Row と ft.Column を組み合わせた使用例","href":null,"is_same_bp":false}],"icon":{"type":"icon","icon":{"color":"gray","name":"code"}}}},"children":[{"blockId":"344a501ef33780229d46eefa6d67b2b2","type":"code","parent":{"type":"code","code":{"language":"python","caption":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これはFletでアプリの見た目を設定しただけのコードです。各ボタンやチェックボックスに機能は付いていません","href":null,"is_same_bp":false}],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    datepicker = ft.DatePicker(\n    )\n\n    row1 = ft.Row(\n        controls=[\n            ft.Icon(icon=ft.Icons.DRIVE_FILE_RENAME_OUTLINE, size=40),\n            ft.TextField(label=\"名前\", height=55, expand=1),\n            ft.FilledButton(content=\"送信\", height=40),\n        ]\n    )\n    row2 = ft.RadioGroup(\n        content=ft.Row(\n            controls=[\n                ft.Radio(value=\"first\", label=\"１回生\", expand=1),\n                ft.Radio(value=\"second\", label=\"２回生\", expand=1),\n                ft.Radio(value=\"third\", label=\"３回生\", expand=1),\n                ft.Radio(value=\"fourth\", label=\"４回生\", expand=1),\n            ]\n        )\n    )\n    row3 = ft.Row(\n        controls=[\n            ft.Text(value=\"学部\", width=50, text_align=\"CENTER\"),\n            ft.Dropdown(\n                options=[\n                    ft.dropdown.Option(text=\"先端理工学部\"),\n                    ft.dropdown.Option(text=\"農学部\"),\n                    ft.dropdown.Option(text=\"社会学部\"),\n                ],\n                height=55,\n                expand=1,\n            )\n        ]\n    )\n    row4 = ft.Row(\n        controls=[\n            ft.Text(value=\"誕生日\", width=50, text_align=\"CENTER\"),\n            ft.Dropdown(\n                options=[ft.dropdown.Option(option) for option in range(2024,1900,-1)],\n                label=\"年\",\n                expand=3,\n            ),\n            ft.Dropdown(\n                options=[ft.dropdown.Option(option) for option in range(1,13)],\n                label=\"月\",\n                expand=2,\n            ),\n            ft.Dropdown(\n                options=[ft.dropdown.Option(option) for option in range(1,32)],\n                label=\"日\",\n                expand=2,\n            ),\n        ]\n    )\n    row5 = ft.Row(\n        controls=[\n            ft.Text(value=\"キッカケ\", expand=1),\n            ft.Checkbox(label=\"Twitter\", value=False, expand=1),\n            ft.Checkbox(label=\"Instagram\", value=False, expand=1),\n            ft.Checkbox(label=\"ビラ\", value=False, expand=1),\n            ft.Checkbox(label=\"その他\", value=False, expand=1),\n        ]\n    )\n    \n    column = ft.Column(controls=[row1, row2, row3, row4, row5])\n\n    page.add(column)\n\nft.run(main)","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"344a501ef33780e888b6d4562fce1392","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[{"blockId":"344a501ef337804984e7f2ad97849a36","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"前回(Fletの練習問題2)","href":"/posts/curriculums/1f2a501ef337815ca39fee7c9b906b66","is_same_bp":false},{"annotations":{"bold":false,"code":false,"colo