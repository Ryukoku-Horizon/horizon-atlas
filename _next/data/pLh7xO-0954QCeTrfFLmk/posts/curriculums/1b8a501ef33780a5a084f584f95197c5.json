agraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Pythonのfor文は、他言語でよく使う","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for (i = 0; i < 5; i++)","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"みたいなforの書き方はできません。この書き方に慣れている人は記述方法や使い方が違いすぎて困惑するかもしれません。ですが、慣れればとても便利と感じるはずです。頑張って触ってみてください。","href":null}]},"children":[]}]},{"blockId":"1b8a501ef33781ce83f1f0d74e07899b","type":"heading_1","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"リストによる繰り返し","href":null}]},"children":[]},{"blockId":"1b8a501ef33781c09361f46fa80a5367","type":"divider","parent":"_","children":[]},{"blockId":"1b8a501ef33781ec8762e54d618a98be","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for文","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"とは、例えば工場の製造ラインのようなものです。製造ラインには様々な部品（これがリストの要素にあたります）が順番に流れてきて、それぞれに対して同じ作業（これがfor文で定義する操作にあたります）が行われます。","href":null}]},"children":[]},{"blockId":"1b8a501ef33781eab76dc0b517e4defb","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for文","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"は以下のように記述をします。","href":null}]},"children":[]},{"blockId":"1b8a501ef337819ca88cc34b58e1ef15","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for 変数 in リスト:\n    処理","href":null}]},"children":[]},{"blockId":"1b8a501ef337817a9686e195d072d7cd","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"例えば、リストに","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"[1, 2, 3, 4, 5]","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"が格納されていて、それぞれの数字に対して2を掛けるという処理を行いたいとしましょう。これをPythonの","href":null},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for文","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"で書くと次のようになります。","href":null}]},"children":[]},{"blockId":"1b8a501ef3378129861cc47af0c1fadb","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"numbers = [1, 2, 3, 4, 5]\nfor number in numbers:\n    print(number * 2)","href":null}]},"children":[]},{"blockId":"1b8a501ef33781d58f78e60e04b4f9a3","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"このプログラムでは、まず","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"numbers","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"という名前でリストが定義され、その中には","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"[1, 2, 3, 4, 5]","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"が格納されます。そして","href":null},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for文","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"が始まり、","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"numbers","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"の中にある各要素（ここでは","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"number","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"と名付けています）に対して、その数値を2倍にして表示するという操作が行われます。よって、実行結果は以下のようになります。","href":null}]},"children":[]},{"blockId":"1b8a501ef337812f9ec1fb3a9eb84880","type":"code","parent":{"caption":[],"language":"plain text","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"＜実行結果＞\n2\n4\n6\n8\n10","href":null}]},"children":[]},{"blockId":"1b8a501ef33781c9a7eaf971dc2d0118","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"実はリストや辞書の中身の型は、最初に入れた値で固定されるわけではありません。たとえば、以下のようなリストも作成可能です。","href":null}]},"children":[]},{"blockId":"1b8a501ef3378141a574f240daa4b5b4","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"mixed_list = [1, \"apple\", 3.14, True]\nprint(mixed_list)","href":null}]},"children":[]},{"blockId":"1b8a501ef33781eeac3bc081784bbe55","type":"callout","parent":{"color":"blue_background","icon":{"type":"emoji","emoji":"💡"},"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これは有効ですが、異なる型が混在していると、for文などで処理するときにエラーの原因になったり、意図しない動作を引き起こす可能性があります。そのため、リストや辞書の要素の型を統一することが推奨されます。","href":null}]},"children":[]},{"blockId":"1b8a501ef33781e696aedfa4bbc39242","type":"heading_1","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"range関数による繰り返し","href":null}]},"children":[]},{"blockId":"1b8a501ef337813a8956d9877c59e0b7","type":"divider","parent":"_","children":[]},{"blockId":"1b8a501ef337818fb57ecb1c025b50f2","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Pythonのfor文には、リストだけでなく","href":null},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"range関数","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"というものも使用できます。","href":null}]},"children":[]},{"blockId":"1b8a501ef33781d5bb27e5db55710a58","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これは、単純に◯回同じ処理を繰り返したい、といったときに便利です。基本的な記述方法はこんな感じです。","href":null}]},"children":[]},{"blockId":"1b8a501ef33781dcad24d4726619f6ac","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for 変数 in range(繰り返したい回数):\n    処理","href":null}]},"children":[]},{"blockId":"1b8a501ef33781ab8c2ff3889b08367a","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"例えば、5回繰り返して「Hello World!」と出力したい場合はこのようにプログラムになります。","href":null}]},"children":[]},{"blockId":"1b8a501ef33781bb96c2c0a22839f6ad","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"for i in range(5):\n    print(\"Hello World!\")","href":null}]},"children":[]},{"blockId":"1b8a501ef33781f4b8d7ff823490705a","type":"code","parent":{"caption":[],"language":"plain text","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"＜実行結果＞\nHello World!\nHello World!\nHello World!\nHello World!\nHello World!","href":null}]},"children":[]},{"blockId":"1b8a501ef33781ddb5f7cd3594cee300","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"事前にリストを用意する必要がないため気軽に実行できます。","href":null}]},"children":[]},{"blockId":"1b8a501ef33781418d92e6c9cab2d248","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ちなみに繰り返したい回数は、0から始まり(0,1,2,3,4)となるので、表示されるHello world!の回数は5つになります。","href":null}]},"ch