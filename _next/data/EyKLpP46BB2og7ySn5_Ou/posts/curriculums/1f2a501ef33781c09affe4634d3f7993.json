トと辞書","href":"/posts/curriculums/1b8a501ef33780329beede1f29e138fa","mention":{"content":{"iconType":"","iconUrl":"","title":"7. リストと辞書"},"type":"prossedPage"}},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" ）","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"で設定することで、上記のようなウィンドウを表示することができます。","href":null}]},"children":[]},{"blockId":"1f2a501ef337811886d3fb9ea16b02d7","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    icon = ft.Icon(\n        name=ft.Icons.DRIVE_FILE_RENAME_OUTLINE,\n        size=38,\n    )\n    field = ft.TextField(\n        label=\"名前を入力\",\n        height=43,\n        expand=1,\n    )\n    button = ft.FilledButton(\n        text=\"送信\",\n        height=40,\n    )\n    \n    control_list = [icon, field, button]\n\n    row = ft.Row(controls=control_list)\n\n    page.add(row)\n\nft.app(target=main)","href":null}]},"children":[]},{"blockId":"1f2a501ef3378109af04cd7cc7a883d2","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"上記の例ではリストを一度","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"control_list","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"という変数に格納していますが、このように変数を介さない書き方も一般的です。","href":null}]},"children":[]},{"blockId":"1f2a501ef33781f9af88c1d93bf33cc8","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"row = ft.Row(controls=[icon, field, button])","href":null}]},"children":[]},{"blockId":"1f2a501ef33781efb851d6aacaa9aefd","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"もちろん、このRowコントロールも設定できるプロパティを複数持っており、コントロールごとの間隔を設定できる","href":null},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"spacing","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"などがあります。","href":null}]},"children":[]},{"blockId":"1f2a501ef337813192e9fcd703c2f5eb","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    icon = ft.Icon(\n        name=ft.Icons.DRIVE_FILE_RENAME_OUTLINE,\n        size=38,\n    )\n    field = ft.TextField(\n        label=\"名前を入力\",\n        height=43,\n        expand=1,\n    )\n    button = ft.FilledButton(\n        text=\"送信\",\n        height=50,\n    )\n\n    row = ft.Row(\n        controls=[icon, field, button],\n        spacing=50,\n    )\n\n    page.add(row)\n\nft.app(target=main)","href":null}]},"children":[]},{"blockId":"1f2a501ef337810ba97ecfcf37159833","type":"callout","parent":{"color":"gray_background","icon":{"type":"external","external":{"url":"https://www.notion.so/icons/photo-landscape_green.svg"}},"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"spacingの設定の違いによる変化","href":null}]},"children":[{"blockId":"1f2a501ef33781a39897da5193734b0a","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/1f2a501ef33781c09affe4634d3f7993/1f2a501ef33781a39897da5193734b0a.png","height":591,"width":1360,"type":"png"},"children":[]}]},{"blockId":"1f2a501ef337816ebf43e015e94e7a10","type":"heading_1","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ft.Column","href":null}]},"children":[]},{"blockId":"1f2a501ef33781e78185f14b590be97a","type":"divider","parent":"_","children":[]},{"blockId":"1f2a501ef33781f6ac46cfe705025039","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次に、複数のコントロールを縦方向に並べる方法です。","href":null}]},"children":[]},{"blockId":"1f2a501ef33781b9ac51c3ddc393d3f9","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これには、","href":null},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Columコントロール","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"を使用します。","href":null},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Columnコントロール","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"の使用方法は、先程のRowコントロールとよく似ています。","href":null}]},"children":[]},{"blockId":"1f2a501ef33781038879f03df9fa1560","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"controls","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"プロパティに、縦並びにしたい複数のコントロールを","href":null},{"annotations":{"bold":true,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"リスト型","href":null},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"で指定します。","href":null}]},"children":[]},{"blockId":"1f2a501ef3378171a433e6098537fc3d","type":"code","parent":{"caption":[],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    icon = ft.Icon(\n        name=ft.Icons.DRIVE_FILE_RENAME_OUTLINE,\n        size=38,\n    )\n    field = ft.TextField(\n        label=\"名前を入力\",\n        height=43,\n    )\n    button = ft.FilledButton(\n        text=\"送信\",\n        height=40,\n    )\n\n    column = ft.Column(controls=[icon, field, button])\n\n    page.add(column)\n\nft.app(target=main)","href":null}]},"children":[]},{"blockId":"1f2a501ef3378106b9a5cee871d414ce","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/1f2a501ef33781c09affe4634d3f7993/1f2a501ef3378106b9a5cee871d414ce.png","height":392,"width":464,"type":"png"},"children":[]},{"blockId":"1f2a501ef337814dbbfaf227a98f20f6","type":"heading_2","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Columnの用途","href":null}]},"children":[]},{"blockId":"1f2a501ef337812089e0c900e8fc5072","type":"divider","parent":"_","children":[]},{"blockId":"1f2a501ef33781d58425fbf5d6931991","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"このColumnコントロールは、先程のft.Rowで横並びにしたコントロールたちをさらに縦に並べるために使われることが多いです。言葉だけではわかりにくいと思うので、画像とコード例を示します。","href":null}]},"children":[]},{"blockId":"1f2a501ef337810a9c55d9a3393af0d0","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/1f2a501ef33781c09affe4634d3f7993/1f2a501ef337810a9c55d9a3393af0d0.jpg","height":972,"width":1038,"type":"jpg"},"children":[]},{"blockId":"1f2a501ef33781c2ad27efcf631dc5b1","type":"image","parent":{"parent":[],"url":"https://raw.githubusercontent.com/Ryukoku-Horizon/notion2atlas/main/public/assets/1f2a501ef33781c09affe4634d3f7993/1f2a501ef33781c2ad27efcf631dc5b1.png","height":371,"width":652,"type":"png"},"children":[]},{"blockId":"1f2a501ef337819a8955f21be012692a","type":"code","parent":{"caption":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これはFletでアプリの見た目を設定しただけのコードです。各ボタンやチェックボックスに機能は付いていません","href":null}],"language":"python","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    datepicker = ft.DatePicker(\n    )\n\n    row1 = ft.Row(\n        controls=[\n            ft.Icon(name=ft.icons.DRIVE_FILE_RENAME_OUTLINE, size=40),\n            ft.TextField(label=\"名前\", height=55, expand=1),\n            ft.FilledButton(text=\"送信\", height=40),\n        ]\n    )\n    row2 = ft.RadioGroup(\n        content=ft.Row(\n            controls=[\n                ft.Radio(value=\"first\", label=\"１回生\", expand=1),\n                ft.Radio(value=\"second\", label=\"２回生\", expand=1),\n                ft.Radio(value=\"third\", label=\"３回生\", expand=1),\n                ft.Radio(value=\"fourth\", label=\"４回生\", expand=1),\n            ]\n        )\n    )\n    row3 = ft.Row(\n        controls=[\n            ft.Text(value=\"学部\", width=50, text_align=\"CENTER\"),\n            ft.Dropdown(\n                options=[\n                    ft.dropdown.Option(text=\"先端理工学部\"),\n                    ft.dropdown.Option(text=\"農学部\"),\n                    ft.dropdown.Option(text=\"社会学部\"),\n                ],\n                height=55,\n                expand=1,\n            )\n        ]\n    )\n    row4 = ft.Row(\n        controls=[\n            ft.Text(value=\"誕生日\", width=50, text_align=\"CENTER\"),\n            ft.Dropdown(\n                options=[ft.dropdown.Option(option) for option in range(2024,1900,-1)],\n                label=\"年\",\n                expand=3,\n            ),\n            ft.Dropdown(\n                options=[ft.dropdown.Option(option) for option in range(1,13)],\n                label=\"月\",\n                expand=2,\n            ),\n            ft.Dropdown(\n                options=[ft.dropdown.Option(option) for option in range(1,32)],\n                label=\"日\",\n                expand=2,\n            ),\n        ]\n    )\n    row5 = ft.Row(\n        controls=[\n            ft.Text(value=\"キッカケ\", expand=1),\n            ft.Checkbox(label=\"Twitter\", value=False, expand=1),\n            ft.Checkbox(label=\"Instagram\", value=False, expand=1),\n            ft.Checkbox(label=\"ビラ\", value=False, expand=1),\n            ft.Checkbox(label=\"その他\", value=False, expand=1),\n        ]\n    )\n    \n    column = ft.Column(controls=[row1, row2, row3, row4, row5])\n\n    page.add(column)\n\nft.app(target=main)","href":null}]},"children":[]},{"blockId":"1f2a501ef337812fbe57d57589a1febc","type":"paragraph","parent":{"color":"default","parent":[]},"children":[]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"基礎班カリキュラム","link":"/posts/course/basic"},{"title":"前期","link":"/posts/course/1aea501ef3378112b0b8fd0af1fe66fb"},{"title":"Flet の基礎","link":"/posts/curriculums/1f2a501ef3378055b70de6fcbb3bbb87"},{"link":"/posts/curriculums/1f2a501ef33781c09affe4634d3f7993","title":"7. コントロールのレイアウト"}],"pageId":"1f2a501ef33781c09affe4634d3f7993","iconUrl":"https://www.notion.so/icons/list-indent_red.svg","iconType":"external","coverUrl":"","firstText":"今回はコントロールをウィンドウ上にレイアウトする方法をお伝えします。"},"__N_SSG":true}