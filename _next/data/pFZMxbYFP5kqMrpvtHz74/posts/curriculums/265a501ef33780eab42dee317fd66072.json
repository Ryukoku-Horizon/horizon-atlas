:false,"underline":false},"plain_text":"インスタンスが存在する限り値が保持される","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"8114ffb2cbce409a84d977680d4505ff","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"class Student:\n    def __init__(self, name, grade):\n        self.name = name      # インスタンス変数\n        self.grade = grade    # インスタンス変数\n    \n    def study(self, subject):\n        # 他のメソッドからもインスタンス変数にアクセスできる\n        print(f\"{self.name}さんは{subject}を勉強しています\")\n\nstudent1 = Student(\"太郎\", 2)\nstudent1.study(\"数学\")  # 太郎さんは数学を勉強しています","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"39159ee6eb3e45eb9ef10fea7cf61712","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"シンプルな例で理解する","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"5bb4dd2af64d4cfda083c352e71c5569","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"a26b5b72f7194adbb197dbc12c5faeab","type":"heading_3","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"例1: ユーザークラス","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"104f49e311944558abc81632c81f224b","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"class User:\n    def __init__(self, name, age):\n        self.name = name\n        self.age = age\n    \n    def greet(self):\n        return f\"こんにちは、{self.name}さん！\"\n    \n    def is_adult(self):\n        return self.age >= 20\n\n# インスタンスを作成\nuser1 = User(\"太郎\", 22)\nuser2 = User(\"花子\", 18)\n\n# メソッドを呼び出し\nprint(user1.greet())        # こんにちは、太郎さん！\nprint(user1.is_adult())     # True\nprint(user2.is_adult())     # False","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"43929fb96ae842f6bc51486d73825741","type":"heading_3","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"例2: 学生クラス（データ管理の実例）","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"8758a627946140448f6213e8cad5e3ee","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"class Student:\n    def __init__(self, name, student_id):\n        self.name = name\n        self.student_id = student_id\n        self.scores = []  # 空のリストで初期化\n    \n    def add_score(self, score):\n        self.scores.append(score)\n    \n    def get_average(self):\n        if len(self.scores) == 0:\n            return 0\n        return sum(self.scores) / len(self.scores)\n    \n    def show_info(self):\n        avg = self.get_average()\n        return f\"{self.name}（ID: {self.student_id}）平均点: {avg:.1f}\"\n\n# 使い方\nstudent = Student(\"山田太郎\", \"S001\")\nstudent.add_score(85)\nstudent.add_score(92)\nstudent.add_score(78)\nprint(student.show_info())  # 山田太郎（ID: S001）平均点: 85.0","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"685b101c3be34624b7ce43afc3c75c56","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"この例では、学生の情報（名前、ID、点数）と処理（点数追加、平均計算、情報表示）を1つのクラスにまとめています。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"a12b4264580748acb5e9da07cfe762d7","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Fletとの組み合わせ（応用）","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"76dd110d1b194449b305c6c1fb29587a","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"f146272b1cc64924bc30eb78ee90fe8d","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"クラスを自作すると、Fletのコントロールを組み合わせた自作部品も作れます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"ad645e1a890d4e5cb60045263b36b7bc","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\n# 自作クラス（Fletの部品を組み合わせたもの）\nclass NameInput:\n    def __init__(self):\n        self.input = ft.TextField(label=\"名前を入力\")\n        self.button = ft.ElevatedButton(text=\"送信\", on_click=self.say_hello)\n        self.text = ft.Text()\n\n    def say_hello(self, e):\n        self.text.value = f\"こんにちは、{self.input.value}さん！\"\n        self.text.update()\n\n    # Fletに渡せるようにまとめる\n    def controls(self):\n        return [self.input, self.button, self.text]\n\ndef main(page: ft.Page):\n    ui = NameInput()\n    page.add(*ui.controls())\n\nft.app(target=main)","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"745496ade4974976a25ce284c088b480","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"これでPythonのクラスで自分専用のコントロールを作れるのです。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"281a501ef33780049f2ec34f576b43cb","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[]},{"blockId":"5f9a21b9b6654bee80d6bde319f3b4cd","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次のページでは、これらの知識を使って実際にクラスを作る練習問題に取り組みましょう。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"780d6502d6c34c039f6deff882d7eb5f","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"0292c1d745514fa2ad01e04680de345f","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次→","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"クラスの練習問題","href":"/posts/curriculums/26ea501ef33780eda25cfa4915c1b4ab","mention":{"content":{"iconType":"emoji","iconUrl":"📝","title":"クラスの練習問題"},"type":"prossedPage"},"is_same_bp":false}]}},"children":[]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"基礎班カリキュラム","link":"/posts/course/basic"},{"title":"後期","link":"/posts/course/1aea501ef3378132bd43e21de0be4f7b?is_basic=true"},{"title":"Python後期","link":"/posts/curriculums/256a501ef337802e8fcaf378c366fb03"},{"link":"/posts/curriculums/265a501ef33780eab42dee317fd66072","title":"クラス"}],"pageId":"265a501ef33780eab42dee317fd66072","iconUrl":"☸️","iconType":"emoji","coverUrl":"","firstText":"ここではプログラミングの中で重要な構文であるクラスについて説明します","ogpImagePath":"https://raw.githubusercontent.com/Ryukoku-Horizon/atlas-storage/main/notion_data/ogp/265a501ef33780eab42dee317fd66072.png","resourceType":"curriculum","v":"1.1.8"},"__N_S