     ft.Text(value=\"ボタンの中に\", size=20),\n                        ft.Text(\"いろいろ置けます\"),\n                        ft.Row(\n                            controls=[\n                                ft.Icon(name=ft.icons.FAVORITE, color=\"pink\"),\n                                ft.Icon(name=ft.icons.AUDIOTRACK, color=\"green\"),\n                                ft.Icon(name=ft.icons.BEACH_ACCESS, color=\"blue\"),\n                            ]\n                        )\n                    ]\n                )\n            ),\n            ft.Text(value = 'content=ft.Column(中略、\\n    下のコードを参照)')\n        ],\n        horizontal_alignment=ft.CrossAxisAlignment.CENTER\n    )\n\n    filled_tonal_button = ft.Column(\n        controls=[\n            ft.Text(\"ft.FilledTonalButton\"),\n            ft.FilledTonalButton(\n                icon=ft.icons.LOCK,\n                text=\"Bt\",\n                disabled=True,\n                tooltip=\"このボタンは無効です.\",\n            ),\n            ft.Text(value = 'icon=ft.icons.LOCK\\ntext=\"Bt\"\\ndisabled=True\\ntooltip=\"このボタンは無効です.\"\\n')\n        ],\n        horizontal_alignment=ft.CrossAxisAlignment.CENTER\n    )\n\n    row1 = ft.Row(\n        controls=[\n            cupertino_button,\n            elevated_button,\n            filled_tonal_button,\n        ],\n        alignment=ft.MainAxisAlignment.SPACE_EVENLY\n    )\n\n    page.add(row1)\n\nft.app(target=main)\n","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"1f2a501ef3378127bc46e12c034253a5","type":"heading_1","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"主なプロパティ","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"1f2a501ef33781e39d5ff87d820251a6","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"1f2a501ef33781a6ab80ddc50f95284f","type":"paragraph","parent":{"type"