}}}},"children":[{"blockId":"344a501ef33780b5bd88dcffe95dafd6","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    def show_button_text(e):\n        text = e.control.content.value\n        print(text + \" が押されました\")\n\n    button1 = ft.FilledButton(content=ft.Text(\"ボタン1\"), on_click=show_button_text)\n    button2 = ft.FilledButton(content=ft.Text(\"ボタン2\"), on_click=show_button_text)\n    button3 = ft.FilledButton(content=ft.Text(\"ボタン3\"), on_click=show_button_text)\n\n    page.add(ft.Row(controls=[button1, button2, button3]))\n\nft.run(main)","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"344a501ef33780b7b51eec3e6b1736c0","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"この例では、どのボタンが押されても同じ関数","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"show_button_text","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" が呼び出されます。ここでのポイントは ","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"e.control.text","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" の部分です。これは「押されたボタンの","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"text","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" プロパティの値」を取り出す処理であり、押されたボタンのラベル（表示されている文字列）を知ることができます。つまり、イベントオブジェクト","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":true,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"e","href":null,"is_same_bp":false},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" を使って、どのボタンが押されたのかを特定しているわけです。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"344a501ef337809bb666e50cec1dbbe2","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[]},{"blockId":"344a501ef33780fbbbaef74f96265fc1","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"応用：押されたボタンの数字を並べて表示する簡易入力アプリ","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"344a501ef3378019a415f384243f271c","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"344a501ef337801cb0c0f1c39570d5be","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"次のコードは、「1」「2」「3」と書かれたボタンを押すたびに、その数字が左側にどんどん追加されていき、数字の列が形成されていくアプリです。電卓のような入力フォームのイメージで、押した順に数字を確認できます。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"344a501ef337802694d6f70fc2476dd6","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"実際にコードをコピーして実行してみましょう。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"365a501ef33780559590c2f807d8b50b","type":"callout","parent":{"type":"callout","callout":{"color":"default_background","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"応用例","href":null,"is_same_bp":false}],"icon":{"type":"icon","icon":{"color":"gray","name":"code"}}}},"children":[{"blockId":"344a501ef3378034a2d3d903f2659b37","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"import flet as ft\n\ndef main(page: ft.Page):\n    display = ft.Text(value=\"\", size=30)  # 数字列を表示するテキスト\n\n    def add_digit(e):\n        digit = e.control.content.value   # 押されたボタンの文字を取得\n        display.value += digit            # 表示欄に追加（加算ではなく連結）\n        display.update()                  # 表示を更新\n\n    # 数字ボタンを作成\n    b1 = ft.FilledButton(content=ft.Text(\"1\"), on_click=add_digit)\n    b2 = ft.FilledButton(content=ft.Text(\"2\"), on_click=add_digit)\n    b3 = ft.FilledButton(content=ft.Text(\"3\"), on_click=add_digit)\n\n    # UIに追加\n    page.add(\n        ft.Column(\n            controls=[\n                display,\n                ft.Row(controls=[b1, b2, b3])\n            ]\n        )\n    )\n\nft.run(main)","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"344a501ef33780faa990e4f08b5ca759","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"解説","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"344a501ef337809da66dca460a9eb7d3","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"344a501ef337809a8d56f125bd92c017","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"d