raph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"目次","href":null,"is_same_bp":false}]}},"children":[{"blockId":"344a501ef33780f6954edb2fb1137405","type":"table_of_contents","parent":{"type":"table_of_contents","table_of_contents":[{"header_type":2,"block_id":"344a501ef33780cd94d9eed8e4dd7c1a","text":"イベントハンドラとは何か"},{"header_type":2,"block_id":"344a501ef337801c9cc0e965378a50fa","text":"イベントオブジェクトについて"},{"header_type":2,"block_id":"344a501ef33780fbbbaef74f96265fc1","text":"応用：押されたボタンの数字を並べて表示する簡易入力アプリ"},{"header_type":2,"block_id":"344a501ef33780faa990e4f08b5ca759","text":"解説"}]},"children":[]}]},{"blockId":"344a501ef33780f89993d61e0bfd0c49","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"344a501ef33780cd94d9eed8e4dd7c1a","type":"heading_2","parent":{"type":"header","header":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"イベントハンドラとは何か","href":null,"is_same_bp":false}],"is_toggleable":false}},"children":[]},{"blockId":"344a501ef33780eeb2a3dcb92c3efe39","type":"divider","parent":{"type":"none"},"children":[]},{"blockId":"344a501ef3378070a56ee8b3448431a6","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"イベントハンドラとは、ある「イベント（出来事）」が発生したときに呼び出される関数のことを指します。たとえば、「ボタンがクリックされた」「テキストが入力された」といった出来事がイベントにあたり、それらに応じて何らかの処理を実行するのがイベントハンドラです。","href":null,"is_same_bp":false}]}},"children":[]},{"blockId":"344a501ef3378088976fe4380434fd99","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"default","parent":[]}},"children":[]},{"blockId":"344a501ef33780bb9ad4dbb2883f9092","type":"paragraph","parent":{"type":"paragraph","paragraph":{"color":"defau