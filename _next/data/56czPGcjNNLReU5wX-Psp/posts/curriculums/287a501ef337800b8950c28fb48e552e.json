kId":"28aa501ef3378008b006fd6af64bd4d7","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"仮の最大値を置く（リストの最初の値がオススメ）\n\nリストの中を一つずつ調べる\n\t仮の最大値よりも大きければ、リストの値と置き換える","href":null,"is_same_bp":false}]}},"children":[]}]},{"blockId":"288a501ef3378068a198fb9521d7e1fc","type":"callout","parent":{"type":"callout","callout":{"color":"default_background","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"prac5-ex.py","href":null,"is_same_bp":false}],"icon":{"type":""}}},"children":[{"blockId":"288a501ef33780fbb901f22ecfc91481","type":"code","parent":{"type":"code","code":{"language":"python","caption":[],"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"# 引数として受け取ったリストの最大値を返すfind_max関数と、最小値を返すfind_min関数を定義し、それを使用して以下のリストの最大値、最小値を求め表示してください\n# ただし、自作関数内でPythonの組み込み関数（max関数など）は使用しないでください\n# numbers = [-46, 82, 17, -33, 59, 6, 91, -12, 40]\n\ndef find_max(l):\n    max = l[0]\n    for i in l:\n        if i > max:\n            max = i\n    return max\n\ndef find_min(l):\n    min = l[0]\n    for i in l:\n        if i < min:\n            min = i\n    return min\n\nnumbers = [-46, 82, 17, -33, 59, 6, 91, -12, 40]\nprint(\"リスト\", numbers, \"の最大値は\", find_max(numbers), \"、最小値は\", find_min(numbers), \"です\")","href":null,"is_same_bp":false}]}},"children":[]}]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"解答ページ","link":"/posts/answers"},{"title":"Python - 練習問題5","link":"/posts/curriculums/287a501ef337800b8950c28fb48e552e"}],"pageId":"287a501ef337800b8950c28fb48e552e","iconUrl":"","iconType":"","coverUrl":"","firstText":"練習問題5おつかれまさでした！","ogpImagePath":"https://raw.githubusercontent.com/suma341/notion2atlas/main/notion_data/ogp/287a501ef337800b8950c28fb48e552e.png","resourceType":"answer","v":"1.2.32"},"__N_SSG":true}