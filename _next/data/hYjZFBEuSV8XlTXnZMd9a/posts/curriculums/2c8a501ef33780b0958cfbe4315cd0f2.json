t","italic":false,"strikethrough":false,"underline":false},"plain_text":"現在はHTTPに暗号化を加えたHTTPSというプロトコルが使われています。","href":null}]},"children":[]},{"blockId":"2c8a501ef33780c0b18bd351a3eaa546","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"プロトコルは、ネットワーク上の交通ルールのようなものです。","href":null}]},"children":[]},{"blockId":"2c8a501ef33780b7b474f852f2ecb2cb","type":"heading_3","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ドメイン","href":null}]},"children":[]},{"blockId":"2c8a501ef337802f98b3ce0d55b73b46","type":"divider","parent":"_","children":[]},{"blockId":"2c8a501ef337808cab84e4dab033f3b7","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ドメインはコンピューターの場所を示す部分です。","href":null}]},"children":[]},{"blockId":"2c8a501ef3378062a0c0df932bcb8265","type":"bulleted_list_item","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"Google → google.com","href":null}]},"children":[]},{"blockId":"2c8a501ef33780679f2febb3a7aec8ca","type":"bulleted_list_item","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"YouTube → youtube.com","href":null}]},"children":[]},{"blockId":"2c8a501ef33780a69feec5b3318bcfc0","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"コンピューターにはIPアドレスという一意に識別するアドレスが割り当てられています。しかし、IPアドレスは数字の羅列で人間には理解しにくいです。そこで、IPアドレスと変換可能な人間が理解しやすい名前が用意され、これをドメインと言います。","href":null}]},"children":[]},{"blockId":"2c8a501ef33780b58a3ac63ab13016ee","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ドメインからIPアドレスに変換する仕組みをDNS（Domain Name System）と言います。このDNSを提供しているサーバーをDNSサーバーといいます。","href":null}]},"children":[]},{"blockId":"2c8a501ef33780858e90fedcb75484a3","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"DNS はインターネットの電話帳のようなものです。","href":null}]},"children":[]},{"blockId":"2c8a501ef3378020bf20c5f550aad8a2","type":"heading_3","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ファイルパス","href":null}]},"children":[]},{"blockId":"2c8a501ef33780c3b82bfa8fe70f4781","type":"divider","parent":"_","children":[]},{"blockId":"2c8a501ef3378043b9bbd3805adb7cc0","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"ファイルパスは、そのコンピューター内のファイルの住所です。つまり、このファイルパスによってサーバー内のどのリソースをリクエストするかを指定します。","href":null}]},"children":[]},{"blockId":"2c8a501ef337804290c1df938e67ef4f","type":"heading_2","parent":{"color":"default","is_toggleable":false,"parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"まとめ","href":null}]},"children":[]},{"blockId":"2c8a501ef3378006bb78f7868392c82b","type":"divider","parent":"_","children":[]},{"blockId":"2c8a501ef33780c29e19d787013029f2","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"URLは、プロトコル（どの道を使うか）、ドメイン（どのコンピューターか）、ファイルパス（どのリソースか）を指定します。","href":null}]},"children":[]},{"blockId":"2c8a501ef33780479705f9629ab4fa19","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"つまり、URLによって、クライアントがどのルートでどのコンピューターのどのリソースを求めているかを判別できるのです。","href":null}]},"children":[]},{"blockId":"2c8a501ef33780d09719ff323983b97c","type":"divider","parent":"_","children":[]},{"blockId":"2c8a501ef337804e8f20d3457d59c690","type":"paragraph","parent":{"color":"default","parent":[{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":"HTTPについて","href":"/posts/curriculums/2c8a501ef33780a48908ef6886462f93","mention":{"content":{"iconType":"external","iconUrl":"https://www.notion.so/icons/cellular_blue.svg","title":"HTTPについて"},"type":"prossedPage"}},{"annotations":{"bold":false,"code":false,"color":"default","italic":false,"strikethrough":false,"underline":false},"plain_text":" ","href":null}]},"children":[]}],"pageNavs":[{"title":"Home","link":"/posts"},{"title":"Webコース","link":"/posts/course/2cba501ef3378093a839e6ee939ca052"},{"title":"Webアプリのガイド","link":"/posts/curriculums/2c4a501ef337809e8d3aef9f6f2340c1"},{"link":"/posts/curriculums/2c8a501ef33780b0958cfbe4315cd0f2","title":"URLについて"}],"pageId":"2c8a501ef33780b0958cfbe4315cd0f2","iconUrl":"https://www.notion.so/icons/username_blue.svg","iconType":"external","coverUrl":"","firstText":"基本的にブラウザからサーバーにリクエストするときは、URL（Uniform Resource Locator）と呼ばれるネットワーク上の住所を指定します。","resourceType":"curriculum"},"__N_SSG":true}